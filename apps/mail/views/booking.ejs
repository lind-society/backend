<%
  /*
   * Booking confirmation.
   *
   * Written the way HTML email has to be written rather than the way the web is
   * written now: nested tables, inline styles, no flexbox, no grid, no external
   * stylesheet. Outlook renders through Word's engine and Gmail strips <style>
   * blocks on forwarded mail, so anything structural has to survive on its own.
   *
   * Everything reads through `locals` with a fallback — a missing field must
   * degrade to a dash, never blow up an email the guest has already paid for.
   */

  const PRIMARY = '#2E5153';
  const TERTIARY = '#E2F2EC';
  const TEXT = '#192B2B';
  const MUTED = '#5B6B6F';
  const BORDER = '#DCE7E3';

  const FONT =
    "'Quicksand','Segoe UI',-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif";

  const formatDate = (value, withTime) => {
    if (!value) return '-';

    const date = new Date(value);

    if (isNaN(date.getTime())) return '-';

    const options = {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'Asia/Jakarta',
    };

    if (withTime) {
      options.hour = '2-digit';
      options.minute = '2-digit';
    }

    return (
      date.toLocaleString('en-GB', options) + (withTime ? ' WIB' : '')
    );
  };

  const isVilla = locals.bookingType === 'villa';
  const guestName = locals.username || 'there';
  const propertyName = locals.propertyName || 'your reservation';
  const bookingLink = locals.bookingLink || '';
  const bookingCode = locals.bookingCode || '';

  /* Nights are worth stating outright — it is the number guests check first. */
  let nights = 0;

  if (isVilla && locals.checkInDate && locals.checkOutDate) {
    const start = new Date(locals.checkInDate);
    const end = new Date(locals.checkOutDate);

    if (!isNaN(start.getTime()) && !isNaN(end.getTime())) {
      nights = Math.max(
        0,
        Math.round((end - start) / (1000 * 60 * 60 * 24)),
      );
    }
  }

  const rows = [];

  if (isVilla) {
    rows.push(['Check-in', formatDate(locals.checkInDate, true)]);
    rows.push(['Check-out', formatDate(locals.checkOutDate, true)]);

    if (nights > 0) {
      rows.push(['Length of stay', nights + (nights === 1 ? ' night' : ' nights')]);
    }
  } else {
    rows.push(['Date', formatDate(locals.bookingDate, true)]);
  }

  rows.push(['Guests', String(locals.totalGuest || '-')]);

  if (bookingCode) {
    rows.push(['Booking reference', bookingCode]);
  }
%>
<!--[if mso]><style>body,table,td{font-family:Arial,Helvetica,sans-serif !important;}</style><![endif]-->

<div style="display:none;max-height:0;overflow:hidden;opacity:0;visibility:hidden;mso-hide:all;">
  Your stay at <%= propertyName %> is confirmed<%= bookingCode ? ' — reference ' + bookingCode : '' %>.
</div>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#F9FBF9;margin:0;padding:0;">
  <tr>
    <td align="center" style="padding:24px 12px;">

      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" style="width:100%;max-width:600px;background-color:#FFFFFF;border:1px solid <%= BORDER %>;border-radius:12px;overflow:hidden;">

        <!-- Masthead -->
        <tr>
          <td align="center" style="background-color:<%= PRIMARY %>;padding:32px 24px;">
            <div style="font-family:<%= FONT %>;font-size:20px;letter-spacing:4px;color:#FFFFFF;font-weight:700;text-transform:uppercase;">
              Lind&nbsp;Society
            </div>
            <div style="font-family:<%= FONT %>;font-size:12px;letter-spacing:2px;color:<%= TERTIARY %>;text-transform:uppercase;padding-top:6px;">
              Private Villas &amp; Experiences
            </div>
          </td>
        </tr>

        <!-- Confirmation -->
        <tr>
          <td align="center" style="padding:32px 24px 8px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="background-color:<%= TERTIARY %>;border-radius:999px;padding:8px 18px;font-family:<%= FONT %>;font-size:13px;font-weight:700;color:<%= PRIMARY %>;letter-spacing:1px;text-transform:uppercase;">
                  &#10003;&nbsp; Booking confirmed
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td align="center" style="padding:16px 32px 0;">
            <div style="font-family:<%= FONT %>;font-size:26px;line-height:1.3;font-weight:700;color:<%= PRIMARY %>;">
              <%= propertyName %>
            </div>
          </td>
        </tr>

        <tr>
          <td style="padding:20px 32px 0;">
            <p style="margin:0;font-family:<%= FONT %>;font-size:15px;line-height:1.7;color:<%= TEXT %>;">
              Hi <%= guestName %>,
            </p>
            <p style="margin:12px 0 0;font-family:<%= FONT %>;font-size:15px;line-height:1.7;color:<%= TEXT %>;">
              We have received your payment and your reservation is secured.
              Everything below is exactly as booked &mdash; keep this email for
              your records.
            </p>
          </td>
        </tr>

        <!-- Details -->
        <tr>
          <td style="padding:24px 32px 0;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border:1px solid <%= BORDER %>;border-radius:10px;">
              <% rows.forEach(function (row, index) { %>
              <tr>
                <td style="padding:14px 18px;font-family:<%= FONT %>;font-size:14px;color:<%= MUTED %>;<%= index ? 'border-top:1px solid ' + BORDER + ';' : '' %>">
                  <%= row[0] %>
                </td>
                <td align="right" style="padding:14px 18px;font-family:<%= FONT %>;font-size:14px;font-weight:700;color:<%= TEXT %>;<%= index ? 'border-top:1px solid ' + BORDER + ';' : '' %>">
                  <%= row[1] %>
                </td>
              </tr>
              <% }); %>
            </table>
          </td>
        </tr>

        <!-- Amount paid -->
        <tr>
          <td style="padding:16px 32px 0;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;background-color:<%= TERTIARY %>;border-radius:10px;">
              <tr>
                <td style="padding:18px;font-family:<%= FONT %>;font-size:14px;color:<%= PRIMARY %>;">
                  Total paid
                </td>
                <td align="right" style="padding:18px;font-family:<%= FONT %>;font-size:20px;font-weight:700;color:<%= PRIMARY %>;white-space:nowrap;">
                  <%= locals.currencySymbol || '' %>&nbsp;<%= locals.totalAmount || '-' %>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Call to action -->
        <% if (bookingLink) { %>
        <tr>
          <td align="center" style="padding:28px 32px 0;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="center" bgcolor="<%= PRIMARY %>" style="border-radius:8px;">
                  <a href="<%= bookingLink %>" target="_blank" rel="noopener noreferrer"
                     style="display:inline-block;padding:14px 32px;font-family:<%= FONT %>;font-size:15px;font-weight:700;color:#FFFFFF;text-decoration:none;border-radius:8px;">
                    View your reservation
                  </a>
                </td>
              </tr>
            </table>
            <p style="margin:12px 0 0;font-family:<%= FONT %>;font-size:12px;line-height:1.6;color:<%= MUTED %>;">
              This is your personal link &mdash; please do not forward it.
            </p>
          </td>
        </tr>
        <% } %>

        <!-- What happens next -->
        <tr>
          <td style="padding:28px 32px 0;">
            <div style="font-family:<%= FONT %>;font-size:16px;font-weight:700;color:<%= PRIMARY %>;padding-bottom:10px;">
              What happens next
            </div>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;">
              <tr>
                <td valign="top" style="width:24px;padding:6px 0;font-family:<%= FONT %>;font-size:15px;color:<%= PRIMARY %>;">&bull;</td>
                <td style="padding:6px 0;font-family:<%= FONT %>;font-size:14px;line-height:1.7;color:<%= TEXT %>;">
                  Our concierge will reach you on WhatsApp to arrange arrival details.
                </td>
              </tr>
              <tr>
                <td valign="top" style="width:24px;padding:6px 0;font-family:<%= FONT %>;font-size:15px;color:<%= PRIMARY %>;">&bull;</td>
                <td style="padding:6px 0;font-family:<%= FONT %>;font-size:14px;line-height:1.7;color:<%= TEXT %>;">
                  <%= isVilla
                    ? 'Check-in instructions and the property address arrive 24 hours before your stay.'
                    : 'Meeting point and timing are sent 24 hours before your experience.' %>
                </td>
              </tr>
              <tr>
                <td valign="top" style="width:24px;padding:6px 0;font-family:<%= FONT %>;font-size:15px;color:<%= PRIMARY %>;">&bull;</td>
                <td style="padding:6px 0;font-family:<%= FONT %>;font-size:14px;line-height:1.7;color:<%= TEXT %>;">
                  Need a change? Reply to this email<%= bookingCode ? ' quoting ' + bookingCode : '' %> and we will take care of it.
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Security note -->
        <tr>
          <td style="padding:28px 32px 0;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="width:100%;border-top:1px solid <%= BORDER %>;">
              <tr>
                <td style="padding-top:18px;font-family:<%= FONT %>;font-size:12px;line-height:1.7;color:<%= MUTED %>;">
                  <strong style="color:<%= TEXT %>;">Stay safe.</strong>
                  Lind Society will never ask you to pay to a personal bank
                  account, and never asks for card details over WhatsApp or
                  email. If anyone requests that, ignore it and contact us.
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td align="center" style="padding:28px 32px 32px;">
            <p style="margin:0;font-family:<%= FONT %>;font-size:14px;line-height:1.7;color:<%= TEXT %>;">
              Warm regards,<br />
              <strong style="color:<%= PRIMARY %>;">The Lind Society team</strong>
            </p>
          </td>
        </tr>

      </table>

      <div style="font-family:<%= FONT %>;font-size:11px;line-height:1.6;color:#8A9A9C;padding:16px 12px 0;max-width:600px;">
        You are receiving this email because a reservation was made with Lind
        Society using this address.
      </div>

    </td>
  </tr>
</table>
