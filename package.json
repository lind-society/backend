{
  "name": "lind-society-backend",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "postman": "node scripts/generate-postman-collection.mjs",
    "start": "nest start main",
    "start:dev": "nest start main --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env TS_NODE_BASEURL=./dist/apps/main node -r tsconfig-paths/register dist/apps/main/apps/main/src/main.js",
    "start:external-gateway": "nest start external-gateway",
    "start:external-gateway:dev": "nest start external-gateway --watch",
    "start:mail": "nest start mail",
    "start:mail:dev": "nest start mail --watch",
    "start:whatsapp": "nest start whatsapp",
    "start:whatsapp:dev": "nest start whatsapp --watch",
    "lint": "eslint \"{@apps/main,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/main/test/jest-e2e.json",
    "test:booking-flow": "node scripts/e2e-booking-flow.mjs",
    "payment:mark-paid": "node scripts/mark-payment-paid.mjs",
    "typeorm": "pnpm build && npx typeorm",
    "migration:run": "pnpm typeorm migration:run -d dist/apps/main/apps/main/src/database/data-source.js",
    "migration:generate": "pnpm typeorm migration:generate -d dist/apps/main/apps/main/src/database/data-source.js apps/main/src/database/migrations/migration",
    "migration:create": "pnpm typeorm migration:create @apps/main/database/migrations/migration",
    "migration:revert": "pnpm typeorm migration:revert -d dist/apps/main/apps/main/src/database/data-source.js",
    "migration:show": "pnpm typeorm migration:show -d dist/apps/main/apps/main/src/database/data-source.js",
    "migration:reset": "pnpm typeorm schema:drop -d dist/apps/main/apps/main/src/database/data-source.js",
    "admin:create": "node scripts/create-admin.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "start:whatsapp:prod": "cross-env TS_NODE_BASEURL=./dist/apps/whatsapp node -r tsconfig-paths/register dist/apps/whatsapp/apps/whatsapp/src/main.js",
    "start:mail:prod": "cross-env TS_NODE_BASEURL=./dist/apps/mail node -r tsconfig-paths/register dist/apps/mail/apps/mail/src/main.js",
    "start:external-gateway:prod": "cross-env TS_NODE_BASEURL=./dist/apps/external-gateway node -r tsconfig-paths/register dist/apps/external-gateway/apps/external-gateway/src/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@google-cloud/storage": "^8.4.0",
    "@nestjs-modules/mailer": "^4.0.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^12.3.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "amqp-connection-manager": "^5.0.1",
    "amqplib": "^2.2.0",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "minio": "^8.0.7",
    "multer": "^2.5.0",
    "nestjs-paginate": "^16.0.1",
    "nodemailer": "^10.3.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=10.12.1"
  },
  "packageManager": "pnpm@10.34.9",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@apps/main(|/.*)$": "<rootDir>/apps/main/src/$1",
      "^@apps/external-gateway(|/.*)$": "<rootDir>/apps/external-gateway/src/$1",
      "^@apps/whatsapp(|/.*)$": "<rootDir>/apps/whatsapp/src/$1",
      "^@apps/mail(|/.*)$": "<rootDir>/apps/mail/src/$1",
      "^@libs/common(|/.*)$": "<rootDir>/libs/common/$1",
      "^@libs/config(|/.*)$": "<rootDir>/libs/config/$1",
      "^@libs/rabbitmq(|/.*)$": "<rootDir>/libs/rabbitmq/src/$1",
      "^@libs/whatsapp-client(|/.*)$": "<rootDir>/libs/whatsapp-client/src/$1",
      "^@libs/mail-client(|/.*)$": "<rootDir>/libs/mail-client/src/$1",
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^@app/logger(|/.*)$": "<rootDir>/libs/logger/src/$1",
      "^@app/mail-client(|/.*)$": "<rootDir>/libs/mail-client/src/$1",
      "^@app/message-queue-client(|/.*)$": "<rootDir>/libs/message-queue-client/src/$1",
      "^@app/rabbitmq(|/.*)$": "<rootDir>/libs/rabbitmq/src/$1",
      "^@app/scheduler-client(|/.*)$": "<rootDir>/libs/scheduler-client/src/$1",
      "^@app/whatsapp-client(|/.*)$": "<rootDir>/libs/whatsapp-client/src/$1"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "@swc/core",
      "bcrypt",
      "puppeteer"
    ]
  }
}
