# Example only. Copy to .env and replace every CHANGE_ME value.
# Local development values; docker-compose.yml overrides the hosts for containers.

# App
NODE_ENV=development
API_VERSION=v1
HOST=0.0.0.0
MAIN_PORT=4782
EXTERNAL_GATEWAY_PORT=4783

# Database (PostgreSQL)
# and must match DB_*.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=lind_society

# Frontend origins (CORS whitelist)
FE_DEVELOPMENT=http://localhost:4780
FE_STAGING=http://localhost:4780
FE_PRODUCTION=http://localhost:4780
# Admin dashboard: CORS only, never used for guest-facing links
FE_ADMIN=http://localhost:4781

# RabbitMQ (used by the mail and whatsapp services)
RABBITMQ_URL=amqp://lind:CHANGE_ME@localhost:4790
RABBITMQ_DEFAULT_USER=lind
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_HOST=localhost
RABBITMQ_PORT=4790

# Payment (Xendit sandbox keys)
XENDIT_SECRET_KEY=xnd_development_CHANGE_ME
XENDIT_PUBLIC_KEY=xnd_public_development_CHANGE_ME
XENDIT_WEBHOOK_VERIFICATION_TOKEN=CHANGE_ME

# Storage: S3-compatible (SeaweedFS in docker-compose)
STORAGE_PROVIDER=s3
GCP_PROJECT_ID=not-used
GCP_KEY_FILE_PATH=./gcp-key.json
GCP_BUCKET_NAME=not-used

MINIO_ENDPOINT=localhost
MINIO_PORT=4792
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET_NAME=lind-society
MINIO_PUBLIC_BASE_URL=http://localhost:4782/api/v1/storages/files
MINIO_PUBLIC_URL_EXPIRY_SECONDS=3600

S3_ENDPOINT=http://localhost:4792
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_NAME=lind-society
# Files are proxied through the API at /storages/files, so this is the API's
# public URL plus that path.
S3_PUBLIC_BASE_URL=http://localhost:4782/api/v1/storages/files

# JWT
JWT_AT_SECRET=CHANGE_ME
JWT_RT_SECRET=CHANGE_ME
JWT_AT_EXPIRE=1h
JWT_RT_EXPIRE=7d

# Upload limits
PHOTOS_LIMIT_QUANTITY=10
PHOTOS_LIMIT_SIZE=10485760
VIDEOS_LIMIT_QUANTITY=5
VIDEOS_LIMIT_SIZE=104857600
VIDEO_360S_LIMIT_QUANTITY=5
VIDEO_360S_LIMIT_SIZE=104857600
FLOOR_PLANS_LIMIT_QUANTITY=5
FLOOR_PLANS_LIMIT_SIZE=10485760

# Region
GEONAMES_API_USERNAME=demo
INDONESIA_REGION_FETCH=https://ibnux.github.io/data-indonesia
INDONESIA_POSTAL_CODE_FETCH=https://kodepos.vercel.app/search
GLOBAL_REGION_FETCH=http://api.geonames.org
GLOBAL_POSTAL_CODE_FETCH=http://api.geonames.org
COUNTRY_PHONE_CODE_JSON_PATH=./dist/apps/main/apps/main/assets/country-code.json

# Mail (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=you@example.com
MAIL_PASSWORD=CHANGE_ME
MAIL_SENDER_EMAIL=you@example.com
MAIL_SENDER_NAME=Lind Society

# WhatsApp
# Shared secret for POST /bookings/whatsapp/inbound
WHATSAPP_WEBHOOK_TOKEN=CHANGE_ME
# Pinned WhatsApp Web build; empty follows the latest.
# Snapshots: https://github.com/wppconnect-team/wa-version/tree/main/html
WHATSAPP_WEB_VERSION=2.3000.1044534801-alpha
WHATSAPP_MAIN_CLIENT_ID=lind-society-local
WHATSAPP_AUTH_STRATEGY=local
WHATSAPP_SESSION_PATH=./whatsapp-session
# WHATSAPP_WS_ENDPOINT=ws://chrome:3000
WHATSAPP_BROWSER_EXECUTABLE_PATH_UBUNTU=/usr/bin/chromium-browser
WHATSAPP_BROWSER_EXECUTABLE_PATH_WINDOWS="C:/Program Files/Google/Chrome/Application/chrome.exe"

# Currency
BASE_CURRENCY_CODE=IDR

# Payment gateway
PAYMENT_GATEWAY_PROVIDER_NAME=xendit
PAYMENT_GATEWAY_PROVIDER_URL=https://api.xendit.co
XENDIT_USERNAME=xnd_development_CHANGE_ME
# Payments API v3 only accepts this value.
XENDIT_API_VERSION=2024-11-11

# Origin whitelist for the external gateway
LINDWAY_CLIENT=http://localhost:4781
LIND_SOCIETY_CLIENT=http://localhost:4780
LIND_SOCIETY_CLIENT_PROD=http://localhost:4780
